# =============================================
# FD Store API — Variáveis de Ambiente
# Copie para .env e preencha os valores reais
# =============================================

# App
NODE_ENV=development
PORT=3333
FRONTEND_URL=http://localhost:5173

# Banco de dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fd_store?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=troque_por_um_secret_muito_longo_e_aleatorio_aqui
JWT_REFRESH_SECRET=troque_por_outro_secret_muito_longo_e_aleatorio_aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mercado Pago
MP_ACCESS_TOKEN=TEST-seu-access-token-aqui
MP_WEBHOOK_SECRET=seu-webhook-secret-aqui
MP_NOTIFICATION_URL=https://sua-api.render.com/payments/webhook

# Resend (email)
RESEND_API_KEY=re_sua_chave_aqui
FROM_EMAIL=noreply@fdstore.com.br
FROM_NAME=FD Store

# Cloudflare R2 (compatível com S3)
R2_ACCOUNT_ID=seu-account-id
R2_ACCESS_KEY_ID=sua-access-key
R2_SECRET_ACCESS_KEY=sua-secret-key
R2_BUCKET=fd-store-arts
R2_PUBLIC_URL=https://artes.fdstore.com.br

# Bcrypt
BCRYPT_ROUNDS=12
